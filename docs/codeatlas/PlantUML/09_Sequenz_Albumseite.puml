@startuml
autonumber
skinparam backgroundColor #FFFFFF
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 17
skinparam shadowing false
skinparam roundcorner 8
skinparam ArrowColor #176C78
skinparam LineColor #176C78
skinparam classAttributeIconSize 0
skinparam classBackgroundColor #F1F7F8
skinparam classBorderColor #176C78
skinparam componentBackgroundColor #F1F7F8
skinparam componentBorderColor #176C78
skinparam packageBackgroundColor #F8FAFB
skinparam packageBorderColor #819BA3
skinparam NoteBackgroundColor #FFF4DC
skinparam NoteBorderColor #BC8B39
skinparam NoteFontSize 15
skinparam sequenceMessageAlign center
skinparam sequenceParticipantBackgroundColor #F1F7F8
skinparam sequenceParticipantBorderColor #176C78
skinparam sequenceLifeLineBorderColor #819BA3
skinparam sequenceArrowThickness 1.2
hide footbox
title Von JSON-Ressourcen zu Album-Objekten
participant "Home\n_seiteLesen()" as H
participant "_apiLesen()\nFunktion" as API
participant "TidalAuthService" as A
participant "TIDAL OpenAPI" as T
H -> API : Sammlungspfad + sort=-addedAt\noptional page[cursor]
API -> A : get(client, uri)
A -> T : authentifizierter GET
T --> A : JSON-Antwort
A --> API : Response
API --> H : Json {data, links}
H -> H : Album-IDs in Sammlungsreihenfolge sammeln\nnaechsterCursor lesen
loop Gruppen mit höchstens 20 Album-IDs
 loop bis Metadaten-Cursor null
  H -> API : /v2/albums + filter[id]\ninclude=artists,coverArt; optional countryCode
  API -> A : get(client, uri)
  A -> T : authentifizierter GET
  T --> A : data + included + links
  A --> API : Response
  API --> H : Json
  H -> H : Ressourcenindex nach "type:id" bilden\nMetadaten-Cursor prüfen
 end
end
H -> H : Album.ausRessourcen(id, ressourcen)\nfür jede Sammlungs-ID
H --> H : AlbumSeite(List<Album>, naechsterCursor)
note over H,API
 JSON-Decodierung in _apiLesen(); Fachobjekte entstehen danach.
 Fehlende Metadaten führen zu Ersatzwerten, nicht zu erfundenen Daten.
 In _apiLesen() wird vor dem HTTP-Aufruf 300 ms gewartet.
end note
@enduml
